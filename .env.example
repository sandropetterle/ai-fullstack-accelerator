# ============================================================
# AI Fullstack Accelerator — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to version control.
# ============================================================

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------

# Base URL for the ASP.NET Core API (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5255/api

# Timeout in milliseconds for API calls
NEXT_PUBLIC_API_TIMEOUT=30000

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=<generate: openssl rand -base64 32>

# Required when running behind a reverse proxy (e.g. Docker, Azure)
AUTH_TRUST_HOST=true

# ------------------------------------------------------------
# Authentication — OIDC Provider (any provider: Entra, Auth0, Cognito, Okta, Keycloak, etc.)
# Swap providers by changing these four env vars only — no code changes.
# ------------------------------------------------------------

# OIDC issuer URL (from your identity provider)
# Example (Azure Entra External ID):
#   AUTH_ENTRA_ISSUER=https://<tenant>.ciamlogin.com/<tenant>.onmicrosoft.com/v2.0
AUTH_ENTRA_ISSUER=

# Client ID of the frontend application registration
AUTH_ENTRA_CLIENT_ID=

# Client secret for the frontend application registration
AUTH_ENTRA_CLIENT_SECRET=

# OAuth 2.0 scopes to request from the API (space-separated)
# Example: api://<api-client-id>/articles.read
AUTH_API_SCOPE_READ=
AUTH_API_SCOPE_WRITE=

# ------------------------------------------------------------
# CMS — Strapi 5 (server-side only; no NEXT_PUBLIC_ prefix)
# Start CMS: docker compose --profile cms up -d
# ------------------------------------------------------------

STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=<strapi-read-only-api-token>

# ------------------------------------------------------------
# Backend (ASP.NET Core) — set in appsettings.json or env vars
# ------------------------------------------------------------

# ConnectionStrings__DefaultConnection=
#   Leave empty (or omit) for SQLite development.
#   Set to a SQL Server connection string for production.

# FrontendUrl=http://localhost:3000
#   Used for CORS. Set to your production frontend URL in prod.

# Authentication__Authority=
# Authentication__Audience=
# Authentication__RequireHttpsMetadata=true
#   Leave empty/unset to skip JWT validation (local dev without Entra).
#   Set to your OIDC authority and API audience for production.
