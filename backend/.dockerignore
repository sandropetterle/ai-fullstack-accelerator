# ============================================================================
# .dockerignore for the backend (ASP.NET Core) build context = backend/
# Keeps secrets, local artefacts, and test/IDE noise out of the image.
# ============================================================================

# Version control / editor / tooling
.git
.claude
.vscode
.idea
*.log

# .NET build artefacts (rebuilt inside the container)
**/bin
**/obj

# Local secrets / per-env config and local SQLite databases
# (dotnet publish copies appsettings*.json into the output — never bake
# local/dev secrets or a local database file into the image)
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.Production.json
**/secrets.json
**/*.db
**/*.db-shm
**/*.db-wal

# Tests (not needed in the published image)
tests

# Env files (never bake secrets into the image)
.env
.env.*
!.env.example

# Docs not needed at runtime
docs
documentation
