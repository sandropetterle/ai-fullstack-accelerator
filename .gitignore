# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/
/.swc/

# production
/build

# misc
.DS_Store
*.pem
*.pfx
*.p12
*.key
*.jks

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
**/.env
**/.env.*.local

# .NET secrets / per-env config (do not commit real values)
**/secrets.json
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Local.json

# Claude Code per-developer local state
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET backend
**/bin/
**/obj/
*.user
*.suo
.vs/

# SQLite database
*.db
*.db-shm
*.db-wal

# Docker
docker-compose.override.yml

# Azure deployment credentials (sensitive)
deployment/sql-credentials.txt
deployment/DEPLOYMENT_SUMMARY.txt
deployment/azure-resources-output.txt
deployment/azure-container-apps-output.txt
deployment/github-secrets-values.txt

# Playwright auth state (contains session cookies — never commit)
/e2e/.auth/

# Playwright MCP logs
/.playwright-mcp/
storybook-static/

# CMS
cms/node_modules/
cms/.tmp/
cms/build/
cms/package-lock.json
