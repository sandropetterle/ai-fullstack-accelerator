{
  "name": "ai-fullstack-accelerator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "eslint": {
      "ajv": "^6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "puppeteer-core": {
      "@puppeteer/browsers": "^3.2.3"
    },
    "flatted": ">=3.4.0",
    "serialize-javascript": ">=7.0.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "description": "Full-stack starter template: Next.js 16 frontend, ASP.NET Core 10 Clean Architecture API, Azure Bicep IaC and an optional Strapi 5 CMS. Ships configured for AI-assisted development.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "keywords": [
    "fullstack",
    "template",
    "accelerator",
    "nextjs",
    "aspnet",
    "clean-architecture",
    "ai-assisted-development"
  ],
  "author": "Sandro Petterle",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^4.5.0",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/nextjs": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "chromatic": "^18.12.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-security": "^4.2.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.30",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
